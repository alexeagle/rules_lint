"Bazel dependencies for Ruby formatting and linting example"

bazel_dep(name = "rules_lint")
bazel_dep(name = "rules_ruby", version = "0.21.1")

# rules_ruby 0.21.1 does not expose gem patches through bundle_fetch.
single_version_override(
    module_name = "rules_ruby",
    patch_strip = 1,
    patches = ["//tools/format:rules-ruby-gem-patches.patch"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")

local_path_override(
    module_name = "rules_lint",
    path = "../..",
)

ruby = use_extension("@rules_ruby//ruby:extensions.bzl", "ruby")
ruby.toolchain(
    name = "ruby",
    version_file = "//:.ruby-version",
)
ruby.bundle_fetch(
    name = "bundle",
