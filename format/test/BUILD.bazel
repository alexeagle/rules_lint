load("@bazel_skylib//lib:sets.bzl", "sets")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//format:defs.bzl", "format_multirun", "format_test")
load("//format/private:formatter_binary.bzl", "TOOLS")
load(":format_test_attrs_test.bzl", "test_attrs_test")

sh_test(
    name = "ls-files_test",
    srcs = ["ls-files_test.sh"],
    data = ["//format/private:format"],
)

UNIQUE_TOOLS = sets.to_list(sets.make(TOOLS.values()))

# Avoid depending on a bunch of actual tools in the root module.
# That's the job of the example/ submodule.
# Instead, just provide "recording mock" for each formatter we support.
[
    write_file(
        name = "mock_{}_sh".format(t),
        out = "mock_{}.sh".format(t),
        content = [
            "#!/usr/bin/env bash",
            "echo + {} $*".format(t),
        ],
    )
    for t in UNIQUE_TOOLS
]

[
    sh_binary(
        name = "mock_" + t,
        srcs = ["mock_{}.sh".format(t)],
    )
    for t in UNIQUE_TOOLS
]

format_multirun(
    name = "format",
    cc = ":mock_clang-format.sh",
    csharp = ":mock_csharpier.sh",
    css = ":mock_prettier.sh",
    cuda = ":mock_clang-format.sh",
    cue = ":mock_cue-fmt.sh",
    fsharp = ":mock_fantomas.sh",
    gherkin = ":mock_prettier.sh",
    go = ":mock_gofmt.sh",
    go_module = ":mock_modfmt.sh",
    graphql = ":mock_prettier.sh",
    html = ":mock_prettier.sh",
    html_jinja = ":mock_djlint.sh",
    java = ":mock_java-format.sh",
    javascript = ":mock_prettier.sh",
    jsonnet = ":mock_jsonnetfmt.sh",
    kotlin = ":mock_ktfmt.sh",
    markdown = ":mock_prettier.sh",
    nix = ":mock_nixfmt.sh",
    pkl = ":mock_pkl.sh",
    protocol_buffer = ":mock_buf.sh",
    python = ":mock_ruff.sh",
    qml = ":mock_qmlformat.sh",
    ruby = ":mock_stree.sh",
    rust = ":mock_rustfmt.sh",
    scala = ":mock_scalafmt.sh",
    shell = ":mock_shfmt.sh",
    sql = ":mock_prettier.sh",
    starlark = ":mock_buildifier.sh",
    swift = ":mock_swiftformat.sh",
    # TODO: this attribute should be renamed to hcl
    terraform = ":mock_terraform-fmt.sh",
    toml = ":mock_taplo.sh",
    xml = ":mock_prettier.sh",
    yaml = ":mock_yamlfmt.sh",
)

format_multirun(
    name = "format_with_custom_args",
    java = ":mock_java-format.sh",
    java_fix_args = [
        "--replace",
        "--custom",
    ],
    kotlin = ":mock_ktfmt.sh",
    kotlin_check_args = ["--custom-check"],
    kotlin_fix_args = [
        "--custom-fix",
        "--flag",
    ],
    ruby = ":mock_stree.sh",
    ruby_check_args = ["check", "--print-width=80"],
    ruby_fix_args = ["write", "--print-width=80"],
)

sh_test(
    name = "custom_args_test",
    srcs = ["custom_args_test.sh"],
    data = [
        ":format_Ruby_with_stree",
        ":format_Ruby_with_stree.check",
        ":format_with_custom_args_Java_with_java-format.check",
        ":format_with_custom_args_Kotlin_with_ktfmt",
        ":format_with_custom_args_Kotlin_with_ktfmt.check",
        ":format_with_custom_args_Ruby_with_stree",
        ":format_with_custom_args_Ruby_with_stree.check",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Only test_attrs_test below inspects it.
format_test(
    name = "format_test_with_attrs",
    size = "small",
    timeout = "short",
    srcs = ["custom_args_test.sh"],
    shell = ":mock_shfmt.sh",
    tags = ["manual"],
)

test_attrs_test(
    name = "format_test_attrs_test",
    target_under_test = ":format_test_with_attrs_Shell_with_shfmt",
)
