load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//lint/private:patcher_run.bzl", "patcher_run")
load(":lint_test_no_report_test.bzl", "no_report_test", "skipped_lint_test")
load(":lint_test_xml.bzl", "fake_lint_test")
load(":patcher_env_test.bzl", "patcher_env_test")
load(":ruff_fix_test.bzl", "ruff_fix_reports")

# Simulate a Ruff configuration failure, including stdout to catch overwrites.
write_file(
    name = "ruff_failure",
    out = "ruff_failure.sh",
    content = [
        "#!/usr/bin/env bash",
        "echo 'ruff stdout'",
        "echo 'ruff configuration error' >&2",
        "exit 2",
    ],
    is_executable = True,
)

filegroup(
    name = "ruff_source",
    srcs = ["ruff_fix_test.sh"],
    tags = ["lint-with-ruff"],
)

filegroup(
    name = "ruff_empty",
    tags = ["lint-with-ruff"],
)

ruff_fix_reports(
    name = "ruff_failure_reports",
    src = ":ruff_source",
)

ruff_fix_reports(
    name = "ruff_empty_reports",
    src = ":ruff_empty",
)

sh_test(
    name = "ruff_fix_stderr_test",
    size = "small",
    srcs = ["ruff_fix_test.sh"],
    args = [
        "2",
        "$(locations :ruff_failure_reports)",
    ],
    data = [":ruff_failure_reports"],
)

sh_test(
    name = "ruff_fix_empty_test",
    size = "small",
    srcs = ["ruff_fix_test.sh"],
    args = [
        "0",
        "$(locations :ruff_empty_reports)",
    ],
    data = [":ruff_empty_reports"],
)

sh_test(
    name = "clang_tidy_wrapper_test",
    srcs = ["clang_tidy_wrapper_test.sh"],
    args = ["$(rlocationpath @coreutils_toolchains//:resolved_toolchain)"],
    data = [
        "//lint:clang_tidy_wrapper",
        "@coreutils_toolchains//:resolved_toolchain",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

filegroup(
    name = "unlinted",
    srcs = ["clang_tidy_wrapper_test.sh"],
)

# Fails analysis by design, so only the analysis test below may reach it.
skipped_lint_test(
    name = "lint_test_without_report",
    srcs = [":unlinted"],
    tags = ["manual"],
)

no_report_test(
    name = "lint_test_no_report_test",
    target_under_test = ":lint_test_without_report",
)

filegroup(name = "clean_target")

filegroup(name = "dirty_target")

# Fails by design, so only lint_test_xml_test below runs it.
fake_lint_test(
    name = "fake_lint",
    srcs = [
        ":clean_target",
        ":dirty_target",
    ],
    tags = ["manual"],
)

sh_test(
    name = "lint_test_xml_test",
    srcs = ["lint_test_xml_test.sh"],
    args = ["$(rlocationpath :fake_lint)"],
    data = [":fake_lint"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Only analyzed, by patcher_env_test below.
patcher_run(
    name = "patcher",
    files_to_diff = ["clang_tidy_wrapper_test.sh"],
    tags = ["manual"],
    tool = "//lint:clang_tidy_wrapper",
)

patcher_env_test(
    name = "patcher_env_test",
    target_under_test = ":patcher",
)

# The clang-tidy wrapper must fix sources in the patcher's empty child env.
patcher_run(
    name = "clang_tidy_fix.patch",
    testonly = True,
    data = [
        "clang_tidy_fix.sh",
        "@coreutils_toolchains//:resolved_toolchain",
    ],
    files_to_diff = ["clang_tidy_fix_input.txt"],
    tool = "//lint:clang_tidy_wrapper",
    tool_args = [
        "$(execpath @coreutils_toolchains//:resolved_toolchain)",
        "$(execpath clang_tidy_fix.sh)",
        "--fix",
        "lint/test/clang_tidy_fix_input.txt",
    ],
)

diff_test(
    name = "clang_tidy_fix_test",
    file1 = ":clang_tidy_fix.patch",
    file2 = "clang_tidy_fix.patch.expected",
)
